# Nginx configuration for Demo environment
# Redirects HTTP to HTTPS and proxies to Gunicorn

# HTTP server - redirect to HTTPS
server {
    listen 80;
    server_name serv-ics-fco-d-01;
    
    # Redirect all HTTP requests to HTTPS
    return 301 https://$server_name$request_uri;
}

# HTTPS server
server {
    listen 443 ssl http2;
    server_name serv-ics-fco-d-01;
    
    # SSL configuration
    ssl_certificate /opt/fair3r_custom_overlay/ssl/certs/fair3r_custom_overlay.crt;
    ssl_certificate_key /opt/fair3r_custom_overlay/ssl/private/fair3r_custom_overlay.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-RSA-AES256-GCM-SHA512:DHE-RSA-AES256-GCM-SHA512:ECDHE-RSA-AES256-GCM-SHA384:DHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;
    
    # Security headers
    add_header X-Frame-Options DENY;
    add_header X-Content-Type-Options nosniff;
    add_header X-XSS-Protection "1; mode=block";
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    
    # Logging
    access_log /var/log/fair3r_custom_overlay/nginx_access.log;
    error_log /var/log/fair3r_custom_overlay/nginx_error.log;
    
    # Client settings
    client_max_body_size 8M;
    client_body_timeout 60s;
    client_header_timeout 60s;
    
    # Static files
    location /static {
        alias /opt/fair3r_custom_overlay/fair3r_custom_overlay/static/;
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
    }
    
    location /favicon.ico {
        alias /opt/fair3r_custom_overlay/fair3r_custom_overlay/static/favicon.ico;
        expires 1y;
        access_log off;
    }
    
    # Documentation
    location /media {
        alias /opt/fair3r_custom_overlay_docs/;
        autoindex on;
    }
    
    location /docs {
        alias /opt/fair3r_custom_overlay/docs/_build/html/;
        autoindex on;
    }
    
    # Proxy to Gunicorn
    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
        
        # Timeouts
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
        
        # Buffer settings
        proxy_buffering on;
        proxy_buffer_size 4k;
        proxy_buffers 8 4k;
    }
}
