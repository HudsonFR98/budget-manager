# Nginx configuration for Development environment
# Simple proxy to Flask development server

server {
    listen 8080;
    server_name localhost;
    
    # Logging
    access_log /var/log/fair3r_custom_overlay/nginx_access.log;
    error_log /var/log/fair3r_custom_overlay/nginx_error.log;
    
    # Static files
    location /static {
        alias /opt/fair3r_custom_overlay/fair3r_custom_overlay/static/;
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
    }
    
    location /favicon.ico {
        alias /opt/fair3r_custom_overlay/fair3r_custom_overlay/static/favicon.ico;
        expires 1y;
        access_log off;
    }
    
    # Documentation
    location /media {
        alias /opt/fair3r_custom_overlay_docs/;
        autoindex on;
    }
    
    location /docs {
        alias /opt/fair3r_custom_overlay/docs/_build/html/;
        autoindex on;
    }
    
    # Proxy to Flask development server
    location / {
        proxy_pass http://127.0.0.1:5000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # Timeouts
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
        
        # Buffer settings
        proxy_buffering off;  # Disable buffering for development
    }
} 