server {
    listen {{ cookiecutter.nginx_demo_port }};
    sendfile  off;
    client_max_body_size 8M;

    server_name localhost;
    access_log  /var/log/{{ cookiecutter.app }}/access.log;


    location /static {
        autoindex on;
        alias /opt/{{ cookiecutter.app }}/{{ cookiecutter.app }}/static/;
    }

    location /favicon.ico {
        alias /opt/{{ cookiecutter.app }}/{{ cookiecutter.app }}/static/favicon.ico;
    }

    location /media {
        autoindex on;
        alias /opt/{{ cookiecutter.app }}_docs/;
    }

    location /docs {
        alias /opt/{{ cookiecutter.app }}/docs/_build/html/;
    }

    location / {
        try_files $uri @proxy;
    }

    location @proxy {
        proxy_pass http://127.0.0.1:{{ cookiecutter.gunicorn_demo_port }};
        proxy_set_header Host $host:$server_port;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

}
