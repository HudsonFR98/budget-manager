#
# Local development secrets (used by docker-compose in dev context)
#
# IMPORTANT:
# Application context: dev | integration | validation | prod
# - Do not commit real secrets
# - No defaults exist in code/entrypoints: missing variables will fail fast
#

BUDGET_MANAGER_CONTEXT=dev

# PostgreSQL container bootstrap DB (admin DB used by init script)
POSTGRES_DB=postgres
POSTGRES_USER=web
POSTGRES_PASSWORD=budman2025_x

# Application database created by `deploy/init-db.sh`
BUDMAN_DB_NAME=budman

# Flask / application secrets
SECRET_KEY=fr2445zzjknc5eeee85s6w###hjciksd

# Telegram Bot Configuration (required)
TELEGRAM_BOT_TOKEN=7237344537:AAF2dpUWEChJZz9q2X36smwX-5-7xsk51gw
TELEGRAM_CHAT_ID=6440591299

# Initial admin user (created only if no users exist)
ADMIN_USER_USERNAME=admin
ADMIN_USER_PASSWORD=admin123
ADMIN_USER_FIRST_NAME=Admin
ADMIN_USER_LAST_NAME=User
ADMIN_USER_EMAIL=admin@example.com

# Initial reviewer user (created only when username and password are set)
REVIEWER_USER_USERNAME=reviewer
REVIEWER_USER_PASSWORD=reviewer123
REVIEWER_USER_FIRST_NAME=Reviewer
REVIEWER_USER_LAST_NAME=User
REVIEWER_USER_EMAIL=reviewer@example.com
